{
  "name": "Build an agent (Sciences Po)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },

  // Installs Ollama + llama3.2, uv and OpenCode. Runs once (and in prebuilds).
  "onCreateCommand": "bash .devcontainer/setup.sh",

  // Starts the Ollama server every time the codespace starts.
  "postStartCommand": "bash .devcontainer/start-ollama.sh",

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin:/home/vscode/.opencode/bin"
  },

  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
