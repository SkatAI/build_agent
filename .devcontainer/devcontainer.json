{
  "name": "Build an AI agent workshop",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },

  // Installs Ollama + llama3.2, uv and OpenCode. Runs once (and in prebuilds).
  "onCreateCommand": "bash .devcontainer/setup.sh",

  // Starts the Ollama server and the agent's web page every time the codespace starts.
  "postStartCommand": "bash .devcontainer/start-ollama.sh && bash .devcontainer/start-app.sh",

  // The agent's web page (Streamlit) opens in a preview panel.
  "forwardPorts": [8804],
  "portsAttributes": {
    "8804": { "label": "Agent", "onAutoForward": "openPreview" }
  },

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin:/home/vscode/.opencode/bin"
  },

  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
